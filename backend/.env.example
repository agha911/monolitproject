DATABASE_URL=postgresql+asyncpg://monolit:local_demo_only@127.0.0.1:5432/monolit_demo
# Use a separate development bot, never production credentials.
TELEGRAM_BOT_TOKEN=123456789:local-development-placeholder
ENABLE_BOT_POLLING=false
ENABLE_NOTIFICATIONS=false
ENABLE_SEASON_WORKER=false
ENABLE_HISTORICAL_FINALIZER=false
ALLOW_TELEGRAM_LOOKUPS=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional, leave empty to disable the shop admin toggle.
MONOLIT_ADMIN_KEY=
