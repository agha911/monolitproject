FROM node:22-alpine AS frontend
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ENV VITE_DEMO_MODE=true VITE_API_BASE_URL=/
RUN npm run typecheck && npm run lint && npm run build

FROM python:3.12-slim AS demo
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 FRONTEND_DIST=/app/frontend-dist
WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app ./app
COPY --from=frontend /build/dist ./frontend-dist
USER 10001:10001
EXPOSE 8080
CMD ["python", "-m", "uvicorn", "app.demo_site:app", "--host", "0.0.0.0", "--port", "8080"]
